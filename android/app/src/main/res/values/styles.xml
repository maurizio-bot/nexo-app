<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/nexo_bg</item>
    </style>


    <!-- #dueño 02-11/03-11: quitar el splash «feo». Android 12+ SIEMPRE muestra un splash del sistema con el ícono de
         la app; no se puede eliminar, solo controlar. Antes se veía un DISCO NEGRO (#000000, el fondo del ícono adaptativo)
         flotando sobre el fondo de la app (#070812): ese círculo de distinto tono era lo feo. Ahora se le dice al splash
         del sistema: fondo = el color EXACTO de la app, e ícono = el logo NEXO a color (ic_splash_logo, build 2897: el
         logo multicolor sobre transparente, ~86% del lienzo). Al NO fijar iconBackgroundColor, el
         logo se dibuja SIN círculo sobre el fondo oscuro → arranque limpio que se funde con la app. Atributos de
         androidx core-splashscreen (ya usado por postSplashScreenTheme). MainActivity no llama installSplashScreen(): en
         <12 el tema solo pinta el fondo oscuro liso (sin ícono); en 12+ el sistema aplica estos atributos. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:background">@color/nexo_bg</item>
        <item name="android:windowBackground">@color/nexo_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>