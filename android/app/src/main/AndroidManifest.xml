<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISOS BLE CRÍTICOS (Android 14 compatible) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    
    <!-- CRÍTICO: neverForLocation evita depender del GPS -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- FOREGROUND SERVICE (Android 14 requiere esto explícito) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Ronda 2770: micrófono con la pantalla bloqueada u otra app durante una llamada (BleService.foreground) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 13-11 (dueño): compartir pantalla en la videollamada (MediaProjection, ScreenShareService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    
    <!-- UBICACIÓN: FINE sin maxSdkVersion (requerido por Capacitor Geolocation en Android 12+) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- RED para canal WiFi de Nearby -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wi-Fi normal (misma red): descubrir otros NEXO por mDNS/NSD -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi Direct en Android 13+ (sin él, Android lo deniega sin preguntar y nunca funcionaba) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notificaciones de mensajes (Android 13+ hay que declararlo y pedirlo) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ronda 2763: llamada entrante a pantalla completa (si el sistema lo permite; si no, aviso grande) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Build 2880: llamadas tipo WhatsApp (ConnectionService autogestionado / Telecom). Permiso normal, gratis. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Ronda 2765: encender la pantalla con un aviso y pedir que el sistema no congele NEXO (avisos con la pantalla apagada) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 3189 (#87): NEXO vuelve sola tras reiniciar el teléfono (NexoRestartReceiver). Permiso normal: no se le pregunta al usuario -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permiso específico Nearby -->
    <uses-permission android:name="com.google.android.gms.permission.NEARBY_CONNECTIONS" />
    
    <!-- CÁMARA Y AUDIO PARA ATTACHMENTS -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Ronda 2770: vibrar con una llamada entrante con el teléfono en modo vibración (navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Almacenamiento para grabar video persistente -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" android:minSdkVersion="33" />
    <!-- Instalar una APK recibida por chat (Android pide permitirlo la primera vez) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        
        <!-- 3277: uiMode|keyboard|navigation en configChanges (como la plantilla de Capacitor): sin ellos, al cambiar el teléfono de tema
             claro/oscuro (a mano, por horario o por el ahorro de batería) o al enlazar un teclado, Android REHACÍA la ventana: la app
             se recargaba entera y una llamada en curso se perdía. La página ya se adapta sola a esos cambios. -->
        <activity
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout|uiMode|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 3129: enlace de invitación (InviteLink.kt valida dirección, ID y código; lo demás se ignora) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nexo" android:host="i" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maurizio-bot.github.io" android:pathPrefix="/nexo-app/i" />
            </intent-filter>
            <!-- 3161 (dueño 16-11): NEXO en el menú «Compartir» del teléfono, solo texto y enlaces (SharedText.kt valida tipo y tamaño;
                 la app abre «Enviar a…» y pone el texto en la caja del chat elegido). Fotos y vídeos compartidos: después. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- SERVICIO BLE FOREGROUND -->
        <!-- Ronda 2763: "Rechazar" en el aviso de llamada -->
        <receiver android:name="com.nexo.ble.CallDeclineReceiver" android:exported="false" />
        <!-- 3189 (diagnósticos tableta SM-T220 y S24 17-11 04:46, #87): NEXO vuelve sola tras una actualización de NEXO sin abrirla
             (MY_PACKAGE_REPLACED), un reinicio (BOOT_COMPLETED, tras desbloquear: no LOCKED_BOOT_COMPLETED, los datos siguen cifrados
             hasta entonces) o si el sistema la mata (su alarma de vigilancia cada ~15 min, p. ej. al actualizarse el WebView).
             Arranca BleService como el toque FCM. No exportado: estos avisos los manda el sistema y la alarma la propia NEXO. -->
        <receiver android:name="com.nexo.ble.NexoRestartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.nexo.ble.BleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- 13-11 (dueño): compartir pantalla en la videollamada. Android exige un servicio en primer plano de tipo
             mediaProjection mientras se captura la pantalla (con el permiso que el usuario da cada vez). -->
        <service
            android:name="com.nexo.ble.ScreenShareService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Build 2880 (#dueño): llamada entrante tipo WhatsApp/Signal (ConnectionService autogestionado / Telecom).
             El sistema trata la llamada de NEXO como una llamada real (foco de audio, Doze, Bluetooth). Gratis y
             privado (self-managed: no entra en el registro de llamadas). Es ADITIVO: el aviso CallStyle sigue igual. -->
        <service
            android:name="com.nexo.ble.NexoConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- FCM «despertador» tipo WhatsApp (#87): el "toque" de Google despierta NEXO aunque esté cerrada o el
             fabricante la congele. Por Google solo pasa el toque (sin contenido); el mensaje sigue P2P/E2E. La clase
             está en el módulo nexo-ble (Kotlin). Ver docs/FCM.md. -->
        <service
            android:name="com.nexo.ble.NexoFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Photo Picker service para compatibilidad galería en Android 11+ -->
        <service android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
