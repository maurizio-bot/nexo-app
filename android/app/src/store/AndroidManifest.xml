<?xml version="1.0" encoding="utf-8"?>
<!-- COLA 26: manifiesto EXTRA de la versión de Google Play (tipo de compilación «store»; Gradle lo fusiona sobre src/main).
     Google Play no admite el permiso de instalar paquetes sin una declaración que NEXO no puede justificar: la tienda actualiza la app
     y la web de la variante de tienda no ofrece actualizador ni abre APK (src/ui/store_flag.js). Solo se QUITA lo que sobra; nada se añade.
     tools:node="remove" lo quita aunque venga de un módulo (Capacitor o plugins). La APK de GitHub (debug) no ve este archivo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <!-- Dos permisos que NINGÚN código usa y que obligarían a declaraciones en Play: ningún servicio es de tipo «location» (BleService:
         connectedDevice|microphone; ScreenShareService: mediaProjection) y NEXO no usa la librería Nearby de Google Play services. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.NEARBY_CONNECTIONS" tools:node="remove" />
</manifest>
