<?xml version="1.0" encoding="utf-8"?>
<!-- F7 (análisis 07-11, docs/SEGURIDAD_ATAQUE_2026-11-07.md): el FileProvider solo debe exponer la subcarpeta que de
     verdad se comparte (cacheDir/nexo_open: archivos recibidos que el usuario abre con otra app), NO la raíz del caché ni
     la externa. Antes: external-path "." y cache-path "." (raíces enteras, exposición latente). Ahora: solo nexo_open
     (y desde la 3171 la carpeta temporal de la cámara del teléfono, abajo). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="nexo_open" />
    <!-- 3171 (dueño 17-11: fotos con la cámara del teléfono): @capacitor/camera (CameraUtils.createImageFile) pide la foto a la app
         de cámara en un archivo temporal de getExternalFilesDir(Pictures) y le pasa su URI de este FileProvider; sin esta ruta
         getUriForFile falla y el plugin responde «Unable to create photo on disk». Solo esa subcarpeta propia de la app (nada más
         vive ahí; el plugin borra el temporal al devolver la foto en base64, camera.js). -->
    <external-files-path name="nexo_camera" path="Pictures/" />
</paths>
