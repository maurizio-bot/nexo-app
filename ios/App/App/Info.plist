<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>NEXO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>NEXO usa Face ID para desbloquear la app.</string>
	<key>NSCameraUsageDescription</key>
	<string>NEXO usa la cámara para tomar fotos y vídeos y para videollamadas.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NEXO usa el micrófono para notas de voz y llamadas.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>NEXO guarda las fotos y vídeos que recibís en tu galería.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>NEXO accede a tus fotos para que puedas enviarlas y elegir tu foto de perfil.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NEXO usa la red local (Wi-Fi) para hablar con contactos cercanos sin pasar por internet.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NEXO usa Bluetooth para encontrar y hablar con contactos cercanos sin internet.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>NEXO usa Bluetooth para que otros teléfonos cercanos te encuentren.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NEXO usa tu ubicación solo cuando elegís compartirla en un chat.</string>
</dict>
</plist>
