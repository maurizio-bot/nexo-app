{
  "appId": "com.nexo.app",
  "appName": "NEXO",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "NexoBLE": {
      "displayName": "NexoBLE",
      "backgroundColor": "#000000"
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "showSpinner": false,
      "backgroundColor": "#070812"
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    },
    "webContentsDebuggingEnabled": false
  }
}
